# ==== REQUIRED ====
DISCORD_TOKEN=your_bot_token_here

# ==== OPTIONAL ====
GUILD_ID=                      # test server id -> instant slash command sync
BOT_NAME=Aurora Music
EMBED_COLOR=0x5865F2
FOOTER_TEXT=⚡ Aurora Music • free-hosting ready

DEFAULT_VOLUME=0.70
MAX_QUEUE=200
IDLE_TIMEOUT=180
DATABASE_PATH=data/music.db

FFMPEG_PATH=                   # leave empty to use bundled imageio-ffmpeg
YTDLP_COOKIES=                 # path to cookies.txt if YouTube asks for login
YOUTUBE_PLAYER_CLIENT=android,web_embedded,default

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Free hosting keepalive
PORT=8080
SELF_URL=                      # e.g. https://your-app.onrender.com
KEEPALIVE_INTERVAL=600
